# Telegram bot token from @BotFather
BOT_TOKEN=123456:ABC-your-token-here

# Moodle site (PLATO)
PLATO_URL=https://plato.pusan.ac.kr

# Encryption key for stored Moodle tokens.
# Generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# If empty, a key is generated once into DATA_DIR/.secret.key
FERNET_KEY=

# Where the DB and .secret.key live. Defaults to RAILWAY_VOLUME_MOUNT_PATH, else project root.
DATA_DIR=

# Relative paths resolve against DATA_DIR
DB_PATH=plato_bot.sqlite3
TIMEZONE=Asia/Seoul

# Reminder lead times in minutes (comma separated), used as the default for new users
DEFAULT_LEADS=1440,180,60

# How often the deadline watcher runs, minutes
CHECK_INTERVAL_MIN=10
